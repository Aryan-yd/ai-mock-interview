# =========================================================
# Google Gemini API Configuration (InterviewOS / AI Coach)
# =========================================================

# Get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-flash-lite-latest (fast, low-latency)
# Alternative fallbacks: gemini-flash-latest, gemini-pro-latest
GEMINI_MODEL=gemini-flash-lite-latest

# Application Mode:
# 'live' = Connect to Google Gemini API for real-time AI generation & scoring
# 'demo' = Offline simulation mode with pre-defined question banks and rubric scoring
INTERVIEW_MODE=live
